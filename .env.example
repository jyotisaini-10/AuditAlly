PORT=3000
MONGODB_URI=mongodb://localhost:27017/auditally
REDIS_URI=redis://localhost:6379/2
JWT_SECRET=your-secret-key-change-in-production
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Set to 1 to use deterministic mock explanations (no Groq calls)
AUDITALLY_LLM_MOCK=0
# Repeat-scan cache window (seconds). Set SCAN_CACHE_DISABLED=1 to turn off.
SCAN_CACHE_TTL_SECONDS=3600
SCAN_CACHE_DISABLED=0
# Explanation cache TTL (reuse LLM output for identical violations)
EXPLAIN_CACHE_TTL_SECONDS=604800
# Rate limit: max scans per window per user/IP
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_SCANS=20
RATE_LIMIT_DISABLED=0
# Groq cost estimates (USD per 1M tokens) for transparency display
GROQ_INPUT_COST_PER_1M=0.59
GROQ_OUTPUT_COST_PER_1M=0.79
# Public base URL for shareable report links (set to your Railway backend URL in production)
PUBLIC_URL=http://localhost:8080
# Comma-separated list of allowed frontend origins (your Vercel URL in production)
# e.g. CORS_ORIGIN=https://auditally.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
